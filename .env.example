# ============================================================
# Aira Personal Server 环境配置
# 复制为 .env 后按需修改；时间单位为毫秒，大小单位为字节
# ============================================================

# ---- 建议填写 ----
# 对外访问地址（即 Aira Browser 客户端里填写的地址），末尾斜杠会自动去除
#   公网（反代 + HTTPS）：https://sync.example.com
#   局域网直连：http://192.168.1.10:8787
AIRA_PUBLIC_URL=

# ---- 可选（取消注释行首的 # 后生效，默认值见注释）----

# 配对码有效期（毫秒），默认 600000 = 10 分钟
# 仅限制已配对设备通过 POST /v1/pairing/codes 生成的一次性配对码；
# 服务器初始配对码 /data/setup-code 不过期
#AIRA_PAIRING_CODE_TTL_MS=600000

# 单次请求体大小上限（字节），默认 12582912 = 12 MiB
# 同步数据较大时可调高；若有反向代理，需同步调大代理的 body 限制
#AIRA_BODY_LIMIT_BYTES=12582912

# 历史记录保留时长（毫秒），默认 7776000000 = 90 天，设为 0 表示不按时间清理
# 超过保留窗口的访问记录会被删除，实际保留为「条数 + 时间」双重限制
#AIRA_HISTORY_SYNC_RETENTION_MS=7776000000

# 历史记录保留条数上限，默认 10000，仅保留最新的 N 条访问记录
#AIRA_HISTORY_SYNC_MAX_LIVE_VISITS=10000

# ---- 以下一般无需修改（Docker 部署时由镜像与 Compose 固定）----
# AIRA_HOST=0.0.0.0       # 容器内监听地址
# AIRA_PORT=8787          # 容器内监听端口；如需修改，必须同步修改 compose 的端口映射
# AIRA_DATA_DIR=/data     # 数据目录（SQLite 数据库与配对码），容器内固定为 /data